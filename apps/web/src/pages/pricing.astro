---
// A dedicated /pricing page.
//
// The homepage already carries this exact section at #pricing, and that anchor
// stays. The page exists because Paddle's website verification once asked for
// a "pricing page" URL; it is linked from the footer and older posts, so it
// stays now that there is nothing to buy (ADR 0031), and says so.
//
// It renders the same <Pricing /> and <Faq /> components as the homepage rather
// than restating anything, so the two can never drift.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.tsx";
import Pricing from "../components/Pricing.tsx";
import Faq from "../components/Faq.tsx";
import Footer from "../components/Footer.astro";
---

<Base
  title="Pricing · Hostbeam"
  description="Free to use: every feature, no limit, no reminder, on the Mac and the iPhone. Nothing to buy, no subscription, no account."
>
  <div class="site">
    <Nav />
    <Pricing />
    <Faq />
    <Footer />
  </div>
</Base>
