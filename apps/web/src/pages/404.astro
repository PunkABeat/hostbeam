---
// Astro emits this as dist/404.html; Cloudflare serves it for unmatched paths
// once `assets.not_found_handling` is "404-page" (see wrangler.jsonc). Without
// both halves, an unmatched path gets a bare Cloudflare 404 with no way back to
// the site.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.tsx";
import Footer from "../components/Footer.astro";
import { Ic } from "@hostbeam/ui";
---

<Base
  title="Page not found · Hostbeam"
  description="That page does not exist. Beam a screenshot straight to your own server with Hostbeam."
  noindex
>
  <div class="site" style="display: flex; flex-direction: column; min-height: 100vh">
    <Nav />

    <main style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 96px 0">
      <div class="wrap" style="text-align: center; max-width: 460px">
        <h1 class="h2" style="margin-top: 12px">This page isn't here.</h1>
        <p class="sub" style="margin: 16px auto 0">
          The link may be out of date, or the address slightly off. Nothing was beamed anywhere.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; justify-content: center">
          <a class="btn btn-primary" href="/"><Ic name="arrow-left" size={16} /> Back to Hostbeam</a>
          <a class="btn btn-ink" href="/pricing/">See pricing</a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Base>
