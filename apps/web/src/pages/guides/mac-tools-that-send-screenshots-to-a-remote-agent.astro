          <tr><td>cmux</td><td>—</td><td>Yes, in its own browser panes</td><td>Yes</td><td>A helper</td><td>Free, GPL</td></tr>
          <tr><td>Paste2SSH</td><td>—</td><td>—</td><td>Yes</td><td>Nothing</td><td>Free</td></tr>
          <tr><td>SSH Image Drop</td><td>—</td><td>—</td><td>Yes, and folders</td><td>Nothing</td><td>Free, MIT</td></tr>
          <tr><td>FainLane</td><td>—</td><td>—</td><td>Images</td><td>Nothing</td><td>$12 a year</td></tr>
          <tr><td>clipaste</td><td>—</td><td>—</td><td>Images</td><td>A clipboard shim</td><td>Free, MIT</td></tr>
          <tr><td>SSH Screenshot Bridge</td><td>—</td><td>—</td><td>Images</td><td>Nothing</td><td>Free</td></tr>
          <tr><td>screencp</td><td>—</td><td>—</td><td>Images</td><td>Nothing</td><td>Free</td></tr>
