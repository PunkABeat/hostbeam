---
// One guide page: the shell every guide shares, so a guide file holds only its
// own words. Title, description and dates come from lib/guides.ts, the single
// list the index, the sitemap and /llms.txt also read.
import Base from "./Base.astro";
import Nav from "../components/Nav.tsx";
import Footer from "../components/Footer.astro";
import CopyCommand from "../components/CopyCommand.tsx";
import { guide, longDate } from "../lib/guides";
import { BREW_COMMAND, DMG_URL } from "../lib/links";

interface Props {
  slug: string;
}

const g = guide(Astro.props.slug);
const site = Astro.site ?? Astro.url;
const url = new URL(Astro.url.pathname, site).toString();

// Only what the page itself says: its headline, its dates, who wrote it.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: g.title,
  description: g.description,
  url,
  mainEntityOfPage: url,
  datePublished: g.published,
  dateModified: g.updated,
  inLanguage: "en",
  author: { "@type": "Organization", name: "PunkABeat", url: site.toString() },
  publisher: { "@type": "Organization", name: "PunkABeat", url: site.toString() },
};
---

<Base title={`${g.title} · Hostbeam`} description={g.description} jsonLd={jsonLd}>
  <div class="site" id="top">
    <Nav />
    <main class="wrap guide">
      <p class="crumb"><a href="/guides/">Guides</a></p>
      <h1 class="h2">{g.title}</h1>
      <p class="dated">
        Updated {longDate(g.updated)}. What it says about other tools was checked that day.
      </p>

      <slot />

      <section class="try">
        <h2>Try Hostbeam</h2>
        <p>
          Free, with no limit and no account, on macOS 13 and later. It uses the SSH keys and
          <code class="mono">~/.ssh/config</code> you already have, and installs nothing on the
          server.
        </p>
        <div class="try-row">
          <a class="btn btn-primary btn-sm" href={DMG_URL}>Download for macOS</a>
          <span class="note">or</span>
          <CopyCommand command={BREW_COMMAND} client:visible />
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Base>

<style is:global>
  .guide {
    max-width: 720px;
    padding-top: 56px;
    padding-bottom: 96px;
  }
  .guide .crumb {
    margin: 0 0 14px;
    font-size: 13.5px;
  }
  .guide .crumb a {
    color: var(--ink-faint);
    text-decoration: none;
  }
  .guide .crumb a:hover {
    color: var(--beam);
  }
  .guide h1 {
    font-size: clamp(30px, 4.2vw, 44px);
  }
  .guide .dated {
    margin-top: 14px;
    font-size: 13px;
    color: var(--ink-faint);
  }
  .guide .lede {
    margin-top: 22px;
  }
  .guide section {
    margin-top: 44px;
  }
  .guide h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }
  .guide h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    margin: 26px 0 0;
  }
  .guide p,
  .guide ul,
  .guide ol {
    margin: 14px 0 0;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.7;
  }
  .guide ul,
  .guide ol {
    padding-left: 20px;
  }
  .guide li + li {
    margin-top: 6px;
  }
  .guide b {
    color: var(--ink);
  }
  .guide a:not(.btn) {
    color: var(--beam);
  }
  .guide code.mono {
    font-size: 0.92em;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .guide pre.term {
    margin: 14px 0 0;
    white-space: pre;
    overflow-x: auto;
    line-height: 1.7;
    font-size: 13px;
  }
  .guide .cmd {
    margin-top: 12px;
    max-width: 100%;
    overflow-x: auto;
  }
  .guide .aside {
    margin-top: 8px;
    font-size: 13.5px;
  }
  .guide .table-wrap {
    margin-top: 16px;
    overflow-x: auto;
  }
  .guide table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.55;
  }
  .guide th {
    text-align: left;
    font-weight: 600;
    color: var(--ink);
    padding: 0 14px 8px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .guide td {
    vertical-align: top;
    color: var(--ink-soft);
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .guide tr:last-child td {
    border-bottom: none;
  }
  .guide .try {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--hairline);
  }
  .guide .try-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
  }
</style>
