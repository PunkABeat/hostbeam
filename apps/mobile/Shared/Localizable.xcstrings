          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 최근 스크린샷을 기본 SSH 호스트로 전송하고, 코딩 에이전트에 붙여넣을 수 있는 경로를 복사합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
