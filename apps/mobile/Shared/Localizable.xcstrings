    "%@ isn't in Hostbeam any more. Edit the shortcut to choose another host. Nothing was sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist nicht mehr in Hostbeam. Bearbeite den Kurzbefehl und wähle einen anderen Host. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no está en Hostbeam. Edita el atajo para elegir otro host. No se envió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est plus dans Hostbeam. Modifiez le raccourci pour choisir un autre hôte. Rien n’a été envoyé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Hostbeam にもうありません。ショートカットを編集して別のホストを選んでください。何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 더 이상 Hostbeam에 없습니다. 단축어를 편집해 다른 호스트를 선택하세요. 아무것도 보내지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não está mais no Hostbeam. Edite o atalho para escolher outro host. Nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已不在 Hostbeam 中。请编辑快捷指令选择其他主机。没有发送任何内容。"
          }
        }
      }
    },
