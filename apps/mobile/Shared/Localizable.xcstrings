    "New hosts start with this folder. Change an existing host's folder on its page in Hosts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Hosts starten mit diesem Ordner. Den Ordner eines bestehenden Hosts änderst du auf seiner Seite in Hosts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los hosts nuevos empiezan con esta carpeta. Cambia la carpeta de un host existente en su página, en Hosts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux hôtes commencent avec ce dossier. Pour un hôte existant, changez son dossier sur sa page dans Hôtes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいホストはこのフォルダで始まります。既存のホストのフォルダは、ホスト内のそのホストのページで変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 호스트는 이 폴더로 시작합니다. 기존 호스트의 폴더는 호스트에서 해당 호스트 페이지에서 바꾸세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosts novos começam com esta pasta. Mude a pasta de um host existente na página dele, em Hosts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新主机默认使用此文件夹。要更改已有主机的文件夹,请在“主机”中打开它的页面。"
          }
        }
      }
    },
    "No account. No cloud relay. No telemetry." : {
      "localizations" : {
        "de" : {
