    "Sends your most recent screenshot to your default SSH host and copies a paste-ready path for your coding agent." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet deinen neuesten Screenshot an deinen Standard-SSH-Host und kopiert einen einfügefertigen Pfad für deinen Coding-Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía tu captura más reciente a tu host SSH predeterminado y copia una ruta lista para pegar a tu agente de código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie votre capture la plus récente à votre hôte SSH par défaut et copie un chemin prêt à coller pour votre agent de code."
