    "Purchased — but the license server couldn't be reached. Your purchase is safe; it retries automatically, or tap Restore Purchases." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gekauft — aber der Lizenzserver war nicht erreichbar. Dein Kauf ist sicher; es wird automatisch erneut versucht, oder tippe auf „Käufe wiederherstellen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra realizada, pero no se pudo contactar con el servidor de licencias. Tu compra está segura; se reintenta automáticamente, o toca «Restaurar compras»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achat effectué, mais le serveur de licences est injoignable. Votre achat est en sécurité ; nouvelle tentative automatique, ou touchez « Restaurer les achats »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は完了しましたが、ライセンスサーバーに接続できませんでした。購入は安全です。自動的に再試行されます。「購入内容を復元」をタップしても構いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매는 완료되었지만 라이선스 서버에 연결할 수 없습니다. 구매는 안전하며 자동으로 다시 시도됩니다. '구매 항목 복원'을 눌러도 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra concluída, mas o servidor de licenças está inacessível. Sua compra está segura; novas tentativas são automáticas, ou toque em \"Restaurar compras\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已完成购买，但无法连接许可证服务器。您的购买是安全的；系统会自动重试，也可以点按“恢复购买”。"
          }
        }
      }
    },
