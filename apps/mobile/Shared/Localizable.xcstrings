            "value" : "Kein Konto. Kein Cloud-Relay. Keine Telemetrie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta. Sin relé en la nube. Sin telemetría."
