# Template for scripts/release.env, which scripts/release.sh reads. Secrets are
# op:// references resolved by the 1Password CLI at runtime; nothing in the real
# file is a secret either, but it names the developer, so it is not in the
# public repository. Copy to release.env and fill in.
APPLE_SIGNING_IDENTITY="Developer ID Application: <developer name> (<TEAM ID>)"
APPLE_ID="<apple id email>"
APPLE_TEAM_ID="<TEAM ID>"
APPLE_PASSWORD="op://<vault>/<Apple account item>/<app-specific password field>"
TAURI_SIGNING_PRIVATE_KEY="$HOME/.tauri/hostbeam.key"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD="op://<vault>/<updater key item>/TAURI_SIGNING_PRIVATE_KEY_PASSWORD"
